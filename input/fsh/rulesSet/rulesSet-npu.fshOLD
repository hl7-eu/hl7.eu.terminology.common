// RuleSets for NPU CodeSystem concepts to reduce file size

// Base properties that every NPU concept has
RuleSet: NPUConceptBase(created, changed, status, inactive, system, component, kindOfProperty, specialty, contextDependent, scaleType)
* ^property[0].code = #created_date
* ^property[=].valueDateTime = "{created}"
* ^property[+].code = #change_date
* ^property[=].valueDateTime = "{changed}"
* ^property[+].code = #status
* ^property[=].valueCode = #{status}
* ^property[+].code = #inactive
* ^property[=].valueBoolean = {inactive}
* ^property[+].code = #system
* ^property[=].valueString = "{system}"
* ^property[+].code = #component
* ^property[=].valueString = "{component}"
* ^property[+].code = #kind_of_property
* ^property[=].valueString = "{kindOfProperty}"
* ^property[+].code = #specialty
* ^property[=].valueString = "{specialty}"
* ^property[+].code = #context_dependent
* ^property[=].valueBoolean = {contextDependent}
* ^property[+].code = #scale_type
* ^property[=].valueString = "{scaleType}"

// Optional property rulesets - add after NPUConceptBase as needed
RuleSet: NPUProp_unit(value)
* ^property[+].code = #unit
* ^property[=].valueString = "{value}"

RuleSet: NPUProp_proc(value)
* ^property[+].code = #proc
* ^property[=].valueString = "{value}"

RuleSet: NPUProp_comp_spec(value)
* ^property[+].code = #comp_spec
* ^property[=].valueString = "{value}"

RuleSet: NPUProp_sys_spec(value)
* ^property[+].code = #sys_spec
* ^property[=].valueString = "{value}"

RuleSet: NPUProp_replaces(value)
* ^property[+].code = #replaces
* ^property[=].valueString = "{value}"
