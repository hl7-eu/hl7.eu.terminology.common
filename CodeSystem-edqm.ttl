  ], [
     fhir:index 584 ;
     fhir:CodeSystem.concept.code [ fhir:value "13148000" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Prolonged-release pessary" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Solid, single-dose preparation usually prepared by moulding, of various shapes, usually ovoid, with a volume and consistency suitable for insertion into the vagina to obtain a local effect. It contains one or more active substances dispersed or dissolved in a suitable basis that may be soluble or dispersible in water or may melt at body temperature. It shows a slower release of the active substance(s) than that of a conventional-release pessary. Prolonged release is achieved by a special formulation design and/or manufacturing method." ] ;
