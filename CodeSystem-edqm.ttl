     fhir:index 576 ;
     fhir:CodeSystem.concept.code [ fhir:value "13133000" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Gastro-resistant oral suspension" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Liquid, single-dose or multidose, delayed-release preparation consisting of a suspension intended for oral use. The preparation is intended to resist the gastric fluid and release the active substance(s) in the intestinal fluid. Each dose from a multidose container is administered by means of a device suitable for measuring the prescribed volume. The device is usually a spoon or a cup for volumes of 5 mL or multiples thereof or an oral syringe for other volumes." ] ;
