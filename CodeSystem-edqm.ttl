     fhir:index 189 ;
     fhir:CodeSystem.concept.code [ fhir:value "10227000" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Modified-release tablet" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Solid single-dose preparation consisting of a tablet showing a rate, a place and/or a time of release different from that of a conventional-release tablet. This deliberate modification is achieved by a special formulation design and/or manufacturing method. Modified-release tablets are intended for oral use, and include prolonged-release, delayed-release and pulsatile-release preparations. The generic term 'modified-release tablet' is used only when the more specific terms 'gastro-resistant tablet' or 'prolonged-release tablet' do not apply." ] ;
