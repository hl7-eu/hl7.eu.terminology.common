     fhir:index 181 ;
     fhir:CodeSystem.concept.code [ fhir:value "10219000" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Tablet" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Solid single-dose uncoated preparation obtained by compressing uniform volumes of particulate solids or by other means such as extrusion or moulding. Tablets include single-layer tablets resulting from a single compression of particles and multi-layer tablets consisting of concentric or parallel layers obtained by successive compressions of particles of different composition. Tablets are intended for oral use to release active substance(s) in the gastrointestinal fluids by a rate depending essentially on the intrinsic properties of active substance(s) (conventional release)." ] ;
