     fhir:CodeSystem.concept.code [ fhir:value "0032" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Oromucosal" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Relating to the mouth as the intended site of administration, where the pharmaceutical product is intended for local or systemic action after application to the mucosa of the mouth. For a product intended exclusively for buccal use or sublingual use, the respective specific term 'Buccal' or 'Sublingual' is used instead." ] ;
