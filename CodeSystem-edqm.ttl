     fhir:CodeSystem.concept.code [ fhir:value "30014000" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Cartridge" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Filled container, usually cylindrical, containing a sterile, single-dose or multidose, parenteral preparation; it contains the final preparation in one compartment, or the components necessary for its preparation in different compartments. It may be supplied as an integral part of a pre-filled pen or be intended for use in a reusable device especially designed for that purpose, such as a pen. Dose-dispenser cartridges are excluded." ] ;
