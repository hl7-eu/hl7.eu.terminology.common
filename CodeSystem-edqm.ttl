     fhir:CodeSystem.concept.code [ fhir:value "10225000" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Gastro-resistant tablet" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Solid single-dose, delayed-release tablet intended to resist the gastric fluid and to release the active substance(s) in the intestinal fluid. These properties are achieved by coating the tablet with a gastro-resistant material or by embedding solid particles in the gastro-resistant material before compression. Gastro-resistant tablets are intended for oral administration." ] ;
