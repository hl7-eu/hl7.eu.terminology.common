     fhir:CodeSystem.concept.display [ fhir:value "Emulsion" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "A type of liquid pharmaceutical dose form consisting of a stable dispersion of non-miscible liquids; it consists either of oil droplets in an aqueous continuous phase (oil-in-water emulsion) or aqueous droplets in an oily continuous phase (water-in-oil emulsion); for colloidal dispersions (droplets with a nominal diameter less than approximately 1 micrometre in size), see 'Dispersion'." ] ;
