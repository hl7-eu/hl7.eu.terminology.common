  ], [
     fhir:index 571 ;
     fhir:CodeSystem.concept.code [ fhir:value "13124000" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Medicinal larvae" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Whole, live, medicinal larvae, usually of a species of fly such as Lucilla sericata (common greenbottle fly), provided in an appropriate container such as a mesh bag, intended to be applied to a wound and covered with an appropriate dressing in order to allow debridement of necrotic tissue over a specified period of time (usually a few days). The larvae secrete enzymes into the wound, liquefying the necrotic tissue, and ingest the resulting material." ] ;
